{
  "name": "dsh-omniroute",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "description": "OmniRoute provider surface for DeepSeek Harness: query its live model catalog, its connections, and the quota each upstream connection reports.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maci0/dsh-omniroute.git"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.8 <0.2.0"
    },
    "displayName": "\u4f59\u989d\u4e0e\u989d\u5ea6\u76d1\u63a7\uff08DSH Omniroute\uff09"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "icon": "./icon.svg"
}
